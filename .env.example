# TRUTHLENS AI Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# Backend
ENVIRONMENT=development
PROJECT_NAME="TRUTHLENS AI API"
VERSION="0.1.0"
API_V1_STR="/api/v1"

# Security — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Database (PostgreSQL - Required from Phase 4)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=truthlens_user
POSTGRES_PASSWORD=
POSTGRES_DB=truthlens_db

# ML Model (Required from Phase 4)
MODEL_PATH=models/truthlens_v0.1_checkpoint.pth

# Hugging Face (Optional — for downloading model from Hub)
HF_TOKEN=

# Frontend
VITE_API_URL=http://localhost:8000

